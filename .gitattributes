# 统一换行符策略，保证 Windows / macOS / Linux 克隆后行为一致
* text=auto

# 批处理必须 CRLF，否则在 Windows 上双击可能无法正确执行
*.bat text eol=crlf

# Python / JSON / Markdown 用 LF（跨平台通用，git 默认）
*.py   text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# 音色库体积较大（38MB），走 Git LFS 存储，避免仓库克隆过慢
*.sf3  filter=lfs diff=lfs merge=lfs -text
*.sf2  filter=lfs diff=lfs merge=lfs -text

# 其余二进制资源，禁止任何换行符转换
*.exe  binary
*.dll  binary
*.png  binary
*.wav  binary
*.mid  binary
*.mp3  binary
